#!/usr/bin/env python3
# Stream the pointer position for the omaLens overlay: prints "X Y" (global
# logical coords) whenever it changes, polling Hyprland's request socket at
# ~60 Hz. Exits when stdout closes (the shell stopped the lens).
import os, socket, sys, time

path = os.path.join(os.environ["XDG_RUNTIME_DIR"], "hypr",
                    os.environ["HYPRLAND_INSTANCE_SIGNATURE"], ".socket.sock")
last = None
while True:
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.connect(path)
            s.sendall(b"cursorpos")
            reply = s.recv(64).decode()
        x, y = (p.strip() for p in reply.split(","))
        pos = f"{x} {y}"
        if pos != last:
            sys.stdout.write(pos + "\n")
            sys.stdout.flush()
            last = pos
    except BrokenPipeError:
        break
    except Exception:
        pass
    time.sleep(1 / 60)
