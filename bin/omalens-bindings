#!/usr/bin/env python3
"""Manage omaLens's key-binding block in a Hyprland Lua file.

The block sits between a `-- >>> omaLens` line and a `-- <<< omaLens` line, so
it can be found and replaced later.

  omalens-bindings status FILE   print JSON: {"exists", "marked", "loose"}
                                 (loose = lines mentioning omalens outside the block)
  omalens-bindings write FILE [BLOCK]
                                 replace the existing block with BLOCK (or stdin),
                                 or append it. Copies FILE to the first free
                                 FILE.bak, FILE.bak.1, ... (never overwriting
                                 one) and keeps FILE's permissions. Prints JSON:
                                 {"action", "backup"}.
"""

import itertools
import json
import os
import shutil
import stat
import sys
import tempfile

BEGIN = "-- >>> omaLens"
END = "-- <<< omaLens"


def block_span(lines):
    """Index of the BEGIN and END lines, or None when there's no complete block."""
    start = next((i for i, l in enumerate(lines) if l.strip().startswith(BEGIN)), None)
    if start is None:
        return None
    end = next((i for i in range(start + 1, len(lines)) if lines[i].strip().startswith(END)), None)
    return None if end is None else (start, end)


def read_lines(path):
    try:
        with open(path) as f:
            return f.read().splitlines()
    except FileNotFoundError:
        return None


def status(path):
    lines = read_lines(path)
    if lines is None:
        return {"exists": False, "marked": False, "loose": 0}
    span = block_span(lines)
    inside = range(span[0], span[1] + 1) if span else range(0)
    loose = sum(1 for i, l in enumerate(lines)
                if i not in inside and "omalens" in l.lower() and not l.strip().startswith("--"))
    return {"exists": True, "marked": span is not None, "loose": loose}


def backup(path):
    """Copy path to the first free FILE.bak, FILE.bak.1, ... and return its name.

    O_EXCL never follows or replaces an existing entry (a symlink included), so
    a planted link can't redirect the copy and an earlier backup is never lost.
    """
    st = os.stat(path)
    for n in itertools.count():
        bak = path + ".bak" + (f".{n}" if n else "")
        try:
            fd = os.open(bak, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        except FileExistsError:
            continue
        try:
            os.fchmod(fd, stat.S_IMODE(st.st_mode))
            with os.fdopen(fd, "wb") as dst, open(path, "rb") as src:
                shutil.copyfileobj(src, dst)
            os.utime(bak, ns=(st.st_atime_ns, st.st_mtime_ns))
        except BaseException:
            try:
                os.unlink(bak)
            except OSError:
                pass
            raise
        return bak


def write(path, block):
    block_lines = block.rstrip("\n").splitlines()
    lines = read_lines(path)
    bak = None
    if lines is None:
        lines, action = block_lines, "added"
    else:
        bak = backup(path)
        span = block_span(lines)
        if span:
            lines = lines[:span[0]] + block_lines + lines[span[1] + 1:]
            action = "updated"
        else:
            if lines and lines[-1].strip():
                lines.append("")
            lines += block_lines
            action = "added"
    # Keep the file's permissions (a private 0600 config must stay private);
    # a new file gets the usual umask-derived mode.
    try:
        mode = stat.S_IMODE(os.stat(path).st_mode)
    except FileNotFoundError:
        umask = os.umask(0)
        os.umask(umask)
        mode = 0o666 & ~umask
    # mkstemp creates the temp file 0600 and exclusively; widen to the target
    # mode before writing so the contents are never more exposed than the original.
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".omalens-", suffix=".tmp")
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return {"action": action, "backup": bak}


def main():
    if len(sys.argv) not in (3, 4) or sys.argv[1] not in ("status", "write"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    # realpath: rewrite the target of a symlinked config (dotfiles), not the link.
    cmd, path = sys.argv[1], os.path.realpath(os.path.expanduser(sys.argv[2]))
    if cmd == "status":
        result = status(path)
    else:
        result = write(path, sys.argv[3] if len(sys.argv) == 4 else sys.stdin.read())
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main())
